# Database
DATABASE_URL=
DIRECT_URL=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# AI & LLM
OPENAI_API_KEY=
# Also used by campus knowledge embeddings (text-embedding-3-small, 1536 dimensions).
OPENAI_MODEL=gpt-6-luna
OPENAI_AGENT_ROUTER_MODEL=gpt-6-luna
OPENAI_WEB_SEARCH_MODEL=gpt-6-luna
OPENROUTER_API_KEY=
AGENT_ROUTER_MODE=jev
JEV_ROUTER_MODEL=typesafe/jev-1.13
JEV_ROUTER_MIN_PROBABILITY=0.8

# App & Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=
# Required only for scheduled knowledge checks; use a random value of at least 32 characters.
# Omit the variable when cron is not configured.
# CRON_SECRET=

# Study Memory & OCR
STUDY_MEMORY_MAX_FILE_BYTES=10485760
STUDY_MEMORY_OCR_ENABLED=true
STUDY_MEMORY_OCR_LANG=tha+eng
STUDY_MEMORY_OCR_MAX_PAGES=5
STUDY_MEMORY_OCR_SCALE=2
STUDY_MEMORY_PDF_TEXT_MIN_CHARS=80

# Student sign-in (Google OAuth, bumail.net). Omit all of these when not configured.
# Redirect URI to register: <APP_URL>/api/student/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STUDENT_AUTH_SECRET=   # random, at least 32 characters
# STUDENT_EMAIL_DOMAIN=bumail.net
