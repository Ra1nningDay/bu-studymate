{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/*": [
        "./src/lib/*",
        "./src/lib/rag/*",
        "./src/lib/study/*",
        "./src/lib/router/*",
        "./src/lib/bulinks/*",
        "./src/lib/auth/*"
      ],
      "@/src/lib/*": [
        "./src/lib/*",
        "./src/lib/rag/*",
        "./src/lib/study/*",
        "./src/lib/router/*",
        "./src/lib/bulinks/*",
        "./src/lib/auth/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
