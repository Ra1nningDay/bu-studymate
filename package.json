{
  "name": "bu-studymate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:concise-chat": "tsx --test lib/concise-chat.test.ts",
    "eval:concise-chat": "tsx evals/concise-chat/run.ts",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "check:fresh-info": "tsx scripts/manual-fresh-info-check.ts",
    "line:richmenu:upload": "tsx scripts/upload-rich-menu.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "tsx scripts/prisma.ts migrate dev",
    "db:migrate:deploy": "tsx scripts/prisma.ts migrate deploy",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts",
    "knowledge:import": "tsx scripts/knowledge.ts import",
    "knowledge:source": "tsx scripts/knowledge.ts source",
    "knowledge:check": "tsx scripts/knowledge.ts check",
    "knowledge:faq": "tsx scripts/knowledge.ts faq",
    "test:student-auth": "tsx --test src/services/student-auth.test.ts lib/google-oidc.test.ts",
    "test:knowledge": "tsx --test lib/knowledge-rag.test.ts lib/knowledge-faq.test.ts",
    "test:knowledge:db": "tsx scripts/check-knowledge-db.ts",
    "test:openai-params": "tsx --test lib/openai-params.test.ts",
    "eval:router": "promptfoo eval -c evals/agent-router.eval.yaml --env-file .env.local",
    "eval:p1": "promptfoo eval -c evals/p1-knowledge.eval.yaml --env-file .env.local --max-concurrency 2",
    "eval:p1:seed": "promptfoo eval -c evals/p1-knowledge.eval.yaml --env-file .env.local --max-concurrency 2 --var knowledgeMode=seed",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@next/env": "15.5.19",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "promptfoo": "^0.123.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
