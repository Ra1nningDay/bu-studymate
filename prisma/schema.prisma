generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model KnowledgeItem {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String                   @unique
  category  String
  content   String
  keywords  String[]                 @default([])
  source    String?
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceUrl       String?          @map("source_url")
  sourceHash      String?          @map("source_hash")
  contentHash     String?          @map("content_hash")
  verifiedBy      String?          @map("verified_by")
  verifiedAt      DateTime?        @map("verified_at") @db.Timestamptz(6)
  reviewAfter     DateTime?        @map("review_after") @db.Timestamptz(6)
  validFrom       DateTime?        @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime?        @map("valid_until") @db.Timestamptz(6)
  sourceStatus    String?          @map("source_status")
  sourceCheckedAt DateTime?        @map("source_checked_at") @db.Timestamptz(6)
  sourceKind      String           @default("PAGE") @map("source_kind")
  actionLinks     Json             @default("[]") @map("action_links")
  chunks         KnowledgeChunk[]

  @@index([category])
  @@map("knowledge_items")
}

model KnowledgeChunk {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  knowledgeItemId String                   @map("knowledge_item_id") @db.Uuid
  ordinal         Int
  content         String
  documentHash    String                   @map("document_hash")
  searchText      String                   @map("search_text")
  searchVector    Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")
  embedding       Unsupported("vector(1536)")
  embeddingModel  String                   @map("embedding_model")
  knowledgeItem   KnowledgeItem            @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, ordinal])
  @@map("knowledge_chunks")
}

model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketCode  String   @unique @map("ticket_code")
  lineUserId  String   @map("line_user_id")
  location    String?
  room        String?
  description String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ticketCode])
  @@index([status])
  @@map("tickets")
}

model ChatSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String   @unique @map("line_user_id")
  state      String   @default("IDLE")
  draftData  Json     @default("{}") @map("draft_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lineUserId])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String   @map("line_user_id")
  sessionId  String?  @map("session_id") @db.Uuid
  role       String
  content    String
  intent     String?
  channel    String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// TODO: Add message_sources table for normalized answer citations and source verification metadata.
  /// TODO: Add retention cleanup policy for chat history and operational logs.
  /// TODO: Add user data deletion/export workflows before production launch.
  @@index([lineUserId])
  @@index([createdAt])
  @@index([intent])
  @@index([role])
  @@map("chat_messages")
}

model BotRun {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId         String   @map("line_user_id")
  userMessageId      String?  @map("user_message_id") @db.Uuid
  assistantMessageId String?  @map("assistant_message_id") @db.Uuid
  intent             String?
  status             String
  latencyMs          Int?     @map("latency_ms")
  usedWebSearch      Boolean  @default(false) @map("used_web_search")
  usedOpenAI         Boolean  @default(false) @map("used_openai")
  usedStudyMemory    Boolean  @default(false) @map("used_study_memory")
  usedTicketFlow     Boolean  @default(false) @map("used_ticket_flow")
  errorCode          String?  @map("error_code")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// TODO: Add webhook_events idempotency table keyed by LINE event IDs before accepting high-volume production traffic.
  /// TODO: Add retention cleanup policy for chat history and operational logs.
  /// TODO: Add user data deletion/export workflows before production launch.
  @@index([lineUserId])
  @@index([createdAt])
  @@index([intent])
  @@index([status])
  @@map("bot_runs")
}

model RateLimitEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String   @map("line_user_id")
  scope      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lineUserId, scope, createdAt])
  @@index([createdAt])
  @@map("rate_limit_events")
}

/// Deprecated: replaced by User + UserRole("student"); kept one release, drop in a later contract migration.
model StudentAccount {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String   @unique @map("line_user_id")
  email      String   @unique
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)

  @@map("student_accounts")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  lineUserId   String?    @unique @map("line_user_id")
  passwordHash String?    @map("password_hash")
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  disabledAt   DateTime?  @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  roles        UserRole[]

  @@map("users")
}

model Role {
  id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String     @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Notebook {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String          @map("line_user_id")
  name       String
  emoji      String          @default("📘")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  materials  StudyMaterial[]

  @@unique([lineUserId, name])
  @@index([lineUserId])
  @@map("notebooks")
}

model UserMemory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId String   @map("line_user_id")
  key        String
  value      String
  source     String   @default("inferred")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([lineUserId, key])
  @@index([lineUserId])
  @@map("user_memories")
}

model StudyMaterial {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId  String          @map("line_user_id")
  notebookId  String?         @map("notebook_id") @db.Uuid
  courseName  String          @map("course_name")
  title       String?
  sourceType  String          @default("text") @map("source_type")
  rawText     String          @map("raw_text")
  summary     String?
  keyPoints   Json            @default("[]") @map("key_points")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  notebook    Notebook?       @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  chunks      MaterialChunk[]
  assignments Assignment[]

  @@index([lineUserId])
  @@index([notebookId])
  @@index([courseName])
  @@index([createdAt])
  @@map("study_materials")
}

model MaterialChunk {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId  String        @map("material_id") @db.Uuid
  lineUserId  String        @map("line_user_id")
  courseName  String        @map("course_name")
  content     String
  chunkIndex  Int           @map("chunk_index")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  material    StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  /// TODO: Add nullable pgvector embedding column and vector search after the text MVP is stable.
  @@index([materialId])
  @@index([lineUserId])
  @@index([courseName])
  @@map("material_chunks")
}

model Assignment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineUserId       String         @map("line_user_id")
  courseName       String         @map("course_name")
  title            String
  description      String?
  dueDateText      String?        @map("due_date_text")
  dueAt            DateTime?      @map("due_at") @db.Timestamptz(6)
  sourceMaterialId String?        @map("source_material_id") @db.Uuid
  status           String         @default("OPEN")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceMaterial   StudyMaterial? @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)

  @@index([lineUserId])
  @@index([courseName])
  @@index([status])
  @@index([dueAt])
  @@map("assignments")
}

model AiTokenLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  botRunId         String?  @map("bot_run_id") @db.Uuid
  provider         String
  model            String
  step             String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  cachedTokens     Int      @default(0) @map("cached_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(16, 10)
  costSource       String?  @map("cost_source")
  webSearchCalls   Int?     @map("web_search_calls")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([model])
  @@index([botRunId])
  @@map("ai_token_logs")
}
